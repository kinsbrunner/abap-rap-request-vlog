@Metadata.layer: #CORE

@UI: { headerInfo: { typeName: 'Request Item',
                     title: { type: #STANDARD,
                              label : 'The Item' } } }
                              
annotate entity ZC_RequestItem with
{
  @UI.facet: [{ id: 'Item',
                purpose: #STANDARD,
                type: #IDENTIFICATION_REFERENCE,
                label: 'Request Item',
                position: 10 }]
              
  @UI.hidden: true
  RequestUuid;

  @UI.hidden: true  
  ItemUuid;
  
  @EndUserText.label: 'Product ID'
  @UI: { lineItem: [{ position: 10 }],
         identification: [{ position: 10 }],
         textArrangement: #TEXT_FIRST }
  ProductId;
  
  @EndUserText.label: 'Amount'
  @UI: { lineItem: [{ position: 20 }],
         identification: [{ position: 20 }] }  
  ProductQty;

  @UI.hidden: true
  ProductUom;

  @UI.hidden: true  
  LastChangedAt;

}