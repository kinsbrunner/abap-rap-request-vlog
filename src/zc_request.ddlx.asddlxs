@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Request',
                     typeNamePlural: 'Requests',
                     title: { type: #STANDARD,
                     value: 'ExternalId' },
                     description.value: 'StatusText' } }

annotate entity ZC_Request with
{

  @UI.facet: [ { id: 'Request',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Request',
                 position: 10 },

               { id: 'RequestItems',
                 purpose: #STANDARD,
                 type: #LINEITEM_REFERENCE,
                 label: 'Requested Products',
                 position: 20,
                 targetElement: '_items' } ]

  @UI.lineItem: [{ type: #FOR_ACTION,
                   label: 'Cancel Request',
                   dataAction: 'cancel_request',
                   requiresContext: true,
                   invocationGrouping: #CHANGE_SET }]  //This makes the call a single time when doing in batch

  @UI.identification: [{ type: #FOR_ACTION,
                         position: 10,
                         label: 'Add Quick Product',
                         dataAction: 'add_item' }]

  @UI.adaptationHidden: true
  RequestUuid;

  @EndUserText.label: 'External ID'
  @UI: { lineItem: [{ position: 10 }],
         identification: [{ position: 10 }] }  
  ExternalId;

  @EndUserText.label: 'Requester ID'
  @UI: { lineItem: [{ position: 20 }],
         identification: [{ position: 20 }],
         selectionField: [{ position: 20 }],
         textArrangement: #TEXT_ONLY }
  RequesterId;

  @EndUserText.label: 'Status'
  @UI: { identification: [{ position: 30,
                            criticality: 'StatusCriticality',
                            criticalityRepresentation: #WITH_ICON }] }  
  Status;

  @UI: { lineItem: [{ position: 30,
         criticality: 'StatusCriticality',
         criticalityRepresentation: #WITHOUT_ICON }], 
         selectionField: [{ position: 30 }],
         textArrangement: #TEXT_FIRST }  
  StatusFilter;

  @UI.adaptationHidden: true
  StatusCriticality;

  @EndUserText.label: 'Priority'
  @UI: { lineItem: [{ position: 40 }],
         identification: [{ position: 40 }],
         textArrangement: #TEXT_ONLY,
         selectionField: [{ position: 40 }] }  
  Priority;

  @EndUserText.label: 'Deadline Date'
  @UI: { lineItem: [{ position: 50 }],
         identification: [{ position: 50 }] }  
  DeadlineDate;

  @EndUserText.label: 'Cancellation Reason'
  @UI: { lineItem: [{ position: 60 }],
         identification: [{ position: 60 }] }
  @UI.multiLineText: true
  @UI.hidden: #( CancelReasonHidden )
  CancelReason;

  @EndUserText.label: 'Last Changed At'
  @UI: { lineItem: [{ position: 70 }] }  
  LastChangedAt;

}