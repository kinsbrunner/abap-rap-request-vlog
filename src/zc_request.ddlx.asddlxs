@Metadata.layer: #CORE
@UI: { headerInfo: { typeName: 'Request',
                     typeNamePlural: 'Requests',
                     title: { type: #STANDARD,
                     value: 'ExternalId' },
                     description.value: 'StatusText' } }

annotate entity ZC_Request with
{

  @UI.facet: [ { id: 'Request',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Request',
                 position: 10,
                 targetQualifier: 'Main' },

               { id: 'ReqCancel',
                 purpose: #STANDARD,
                 type: #FIELDGROUP_REFERENCE,
                 label: 'Cancellation Reason',
                 position: 15,
                 targetQualifier: 'Cancel' },

               { id: 'RequestItems',
                 purpose: #STANDARD,
                 type: #LINEITEM_REFERENCE,
                 label: 'Requested Products',
                 position: 20,
                 targetElement: '_items' } ]

  @UI.adaptationHidden: true
  RequestUuid;

  @EndUserText.label: 'External ID'
  @UI: { lineItem: [{ position: 10 }],
         identification: [{ position: 10 }] }  
  ExternalId;

  @EndUserText.label: 'Requester ID'
  @UI: { lineItem: [{ position: 20 }],
         identification: [{ position: 20,
                            qualifier: 'Main' }],
         selectionField: [{ position: 20 }],
         textArrangement: #TEXT_ONLY }
  RequesterId;

  @EndUserText.label: 'Status'
  @UI: { identification: [{ qualifier: 'Main',
                            position: 30,
                            criticality: 'StatusCriticality',
                            criticalityRepresentation: #WITH_ICON }] }  
  Status;

  @UI: { lineItem: [{ position: 30,
         criticality: 'StatusCriticality',
         criticalityRepresentation: #WITHOUT_ICON }], 
         selectionField: [{ position: 30 }],
         textArrangement: #TEXT_FIRST }  
  StatusFilter;

  @UI.adaptationHidden: true
  StatusCriticality;

  @EndUserText.label: 'Priority'
  @UI: { lineItem: [{ position: 40 }],
         identification: [{ qualifier: 'Main', 
                            position: 40 }],
         textArrangement: #TEXT_ONLY,
         selectionField: [{ position: 40 }] }  
  Priority;

  @EndUserText.label: 'Deadline Date'
  @UI: { lineItem: [{ position: 50 }],
         identification: [{ qualifier: 'Main', 
                            position: 50 }] }  
  DeadlineDate;

  @EndUserText.label: 'Cancellation Reason'
  @UI: { lineItem: [{ position: 60 }],
         fieldGroup: [{ qualifier: 'Cancel', 
                        position: 60 }] }
  @UI.multiLineText: true
  CancelReason;

  @EndUserText.label: 'Last Changed At'
  @UI: { lineItem: [{ position: 70 }] }  
  LastChangedAt;

}